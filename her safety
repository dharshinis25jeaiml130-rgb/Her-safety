{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import { defineConfig } from 'vite'\nimport react from '@vitejs/plugin-react'\n\nexport default defineConfig({ plugins: [react()] })\nexport default {\n  content: ['./index.html', './src/**/*.{js,jsx}'],\n  theme: {\n    extend: {\n      colors: {\n        ink: '#08070d',\n        card: '#14111d',\n        brand: '#a855f7',\n        brand2: '#7c3aed'\n      },\n      keyframes: {\n        rise: {\n          from: { opacity: 0, transform: 'translateY(12px)' },\n          to: { opacity: 1, transform: 'none' }\n        }\n      },\n      animation: {\n        rise: 'rise .35s ease-out both'\n      }\n    }\n  },\n  plugins: [],\n}\nexport default {\n  plugins: {\n    tailwindcss: {},\n    autoprefixer: {}\n  }\n}\n{\n  \"name\": \"hersafety\",\n  \"private\": true,\n  \"version\": \"1.0.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite --host\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview --host\"\n  },\n  \"dependencies\": {\n    \"firebase\": \"^10.12.0\",\n    \"react\": \"^18.3.1\",\n    \"react-dom\": \"^18.3.1\"\n  },\n  \"devDependencies\": {\n    \"@vitejs/plugin-react\": \"^4.3.0\",\n    \"autoprefixer\": \"^10.4.19\",\n    \"postcss\": \"^8.4.38\",\n    \"tailwindcss\": \"^3.4.4\",\n    \"vite\": \"^5.3.0\"\n  }\n}\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\" />\n    <meta name=\"theme-color\" content=\"#08070d\" />\n    <link rel=\"manifest\" href=\"/manifest.json\" />\n    <link rel=\"icon\" href=\"/icon.svg\" />\n    <title>HER SAFETY</title>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.jsx\"></script>\n  </body>\n</html>\nimport { useCallback, useEffect, useState } from 'react'\nimport { StoreProvider, useStore } from './lib/store'\nimport { openSmsNow, runSOS } from './lib/emergency'\nimport { buzz, watchShake } from './lib/sensors'\nimport { TabBar } from './ui'\nimport { Login, Splash } from './screens/Auth'\nimport Home from './screens/Home'\nimport SetupSOS from './screens/SetupSOS'\nimport Contacts from './screens/Contacts'\nimport Journey from './screens/Journey'\nimport Profile from './screens/Profile'\nimport { Queue, Timeline } from './screens/Timeline'\nimport Calculator from './screens/Calculator'\nimport Status from './screens/Status'\n\nconst TAB_SCREENS = ['home', 'contacts', 'journey', 'timeline', 'queue', 'profile']\n\nfunction Shell() {\n  const { ready, settings, queue, api, profile, contacts } = useStore()\n  const [screen, setScreen] = useState('splash')\n\n  // After login: profile first, then trusted contacts, then the app.\n  const afterLogin = () =>\n    setScreen(\n      !profile\n        ? 'profile-setup'\n        : contacts.length === 0\n          ? 'contacts-setup'\n          : 'home'\n    )\n\n  // Hidden triggers (hold, calculator code, shake, journey): alert in the background, show a harmless screen.\n  const triggerSOS = useCallback(\n    (reason) => {\n      buzz(30)\n      runSOS(api, reason)\n      setScreen('calculator')\n    },\n    [api]\n  )\n\n  // The visible Emergency button: open the SMS app with everything filled in, and run the full alert too.\n  const emergencyNow = useCallback(() => {\n    if (contacts.length === 0) return setScreen('contacts')\n    buzz(80)\n    openSmsNow(api) // must happen right inside the tap\n    runSOS(api, 'button') // GPS capture, cloud delivery, timeline, queue\n  }, [api, contacts.length])\n\n  useEffect(() => {\n    if (!settings.shake || ['splash', 'login'].includes(screen)) return\n    return watchShake(() => triggerSOS('shake'))\n  }, [settings.shake, screen, triggerSOS])\n\n  if (!ready) return <div className=\"h-full bg-ink\" />\n\n  const props = { go: setScreen, triggerSOS, emergencyNow }\n\n  const views = {\n    splash: <Splash onDone={() => setScreen('login')} />,\n    login: <Login onDone={afterLogin} />,\n    'profile-setup': <Profile first onDone={() => setScreen('contacts-setup')} />,\n    'contacts-setup': <Contacts onboarding onDone={() => setScreen('home')} />,\n    home: <Home {...props} />,\n    setup: <SetupSOS {...props} />,\n    contacts: <Contacts />,\n    journey: <Journey />,\n    timeline: <Timeline />,\n    queue: <Queue />,\n    profile: <Profile onDone={() => setScreen('home')} />,\n    status: <Status {...props} />,\n    calculator: <Calculator {...props} />,\n  }\n\n  return (\n    <div className=\"h-full max-w-md mx-auto overflow-y-auto\">\n      {views[screen]}\n      {TAB_SCREENS.includes(screen) && (\n        <TabBar screen={screen} go={setScreen} queueCount={queue.length} />\n      )}\n    </div>\n  )\n}\n\nexport default function App() {\n  return (\n    <StoreProvider>\n      <Shell />\n    </StoreProvider>\n  )\n}\n@tailwind base;\n@tailwind components;\n@tailwind utilities;\n\nhtml, body, #root {\n  height: 100%;\n}\n\nbody {\n  margin: 0;\n  background: #08070d;\n  color: #f4f0ff;\n  font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n  -webkit-tap-highlight-color: transparent;\n  user-select: none;\n  overscroll-behavior: none;\n}\n\ninput {\n  user-select: text;\n}\n\n// Tiny IndexedDB key-value wrapper. Everything the app needs offline lives here.\nconst DB_NAME = 'hersafety'\nconst STORE = 'kv'\n\nfunction openDb() {\n  return new Promise((resolve, reject) => {\n    const req = indexedDB.open(DB_NAME, 1)\n\n    req.onupgradeneeded = () => req.result.createObjectStore(STORE)\n    req.onsuccess = () => resolve(req.result)\n    req.onerror = () => reject(req.error)\n  })\n}\n\nexport async function get(key, fallback = null) {\n  try {\n    const db = await openDb()\n\n    return await new Promise((resolve) => {\n      const q = db.transaction(STORE).objectStore(STORE).get(key)\n      q.onsuccess = () => resolve(q.result ?? fallback)\n      q.onerror = () => resolve(fallback)\n    })\n  } catch {\n    return fallback\n  }\n}\n\nexport async function set(key, value) {\n  try {\n    const db = await openDb()\n    db.transaction(STORE, 'readwrite').objectStore(STORE).put(value, key)\n  } catch (err) {\n    console.warn('IndexedDB write failed', err)\n  }\n}\n// The emergency engine: capture location, build the message, try every channel in order,\n// queue the alert if all of them fail, and retry later when the network comes back.\n\nimport { getPosition, getBattery, fmtTime } from './sensors'\nimport { pushAlert } from './firebase'\n\nexport function buildMessage({\n  position,\n  battery,\n  at = Date.now(),\n  lost = false,\n  profile = null\n}) {\n  const where = position\n    ? `Latitude: ${position.lat.toFixed(4)} Longitude: ${position.lng.toFixed(4)}`\n    : 'Location unavailable'\n\n  const maps = position\n    ? `maps.google.com/?q=${position.lat},${position.lng}`\n    : 'n/a'\n\n  return [\n    lost\n      ? 'HER SAFETY ALERT - Connection lost after emergency activation.'\n      : 'HER SAFETY ALERT',\n    'I may be in danger.',\n    ...(profile\n      ? [\n          `From: ${profile.name}, ${profile.phone}${\n            profile.bloodGroup ? ', Blood group ' + profile.bloodGroup : ''\n          }`\n        ]\n      : []),\n    `Last Location: ${where}`,\n    `Time: ${fmtTime(at)}`,\n    `Last Battery: ${battery ?? '?'}%`,\n    `Google Maps: ${maps}`,\n    'If this is unexpected, please contact me immediately and inform nearby police.',\n  ].join('\\n')\n}\n\n// ---- delivery channels (tried in priority order) ----\n\n// Browsers cannot send SMS silently. We prepare a ready sms: link; the Offline Queue\n// screen exposes it as a one-tap send. A native wrapper (Capacitor) could send it silently.\nasync function sendSms(alert) {\n  alert.smsLink = `sms:${alert.contacts.join(',')}?body=${encodeURIComponent(alert.text)}`\n  return false\n}\n\nasync function sendInternet(alert) {\n  if (!navigator.onLine) return false\n\n  try {\n    return await pushAlert(alert)\n  } catch {\n    return false\n  }\n}\n\n// Placeholders: Web Bluetooth / Wi-Fi Direct need a native layer to relay messages.\nasync function sendBluetooth() {\n  return false\n}\n\nasync function sendWifiDirect() {\n  return false\n}\n\nconst CHANNELS = [\n  ['SMS Attempted', sendSms],\n  ['Mobile Network / Internet Attempted', sendInternet],\n  ['Bluetooth Relay Attempted', sendBluetooth],\n  ['Wi-Fi Direct Relay Attempted', sendWifiDirect],\n]\n\nasync function deliver(alert, { log }) {\n  for (const [label, send] of CHANNELS) {\n    const ok = await send(alert)\n    log(label, ok ? 'done' : 'failed')\n\n    if (ok) {\n      log('Alert Delivered', 'done')\n      return true\n    }\n  }\n\n  return false\n}\n\nexport async function runSOS(api, reason = 'manual') {\n  const { patch, log, getData } = api\n\n  patch({\n    sos: {\n      active: true,\n      startedAt: Date.now(),\n      reason\n    }\n  })\n\n  log('SOS Activated')\n\n  const battery = await getBattery()\n  let position = await getPosition()\n\n  if (!position) {\n    position = getData().lastKnown?.position ?? null\n  }\n\n  // Fall back to the last known location.\n  if (position) {\n    log('Location Captured')\n    patch({\n      lastKnown: {\n        position,\n        battery,\n        lastActive: Date.now()\n      }\n    })\n  } else {\n    log('Location Captured', 'failed')\n  }\n\n  const alert = {\n    id: crypto.randomUUID(),\n    createdAt: Date.now(),\n    reason,\n    text: buildMessage({\n      position,\n      battery,\n      profile: getData().profile\n    }),\n    contacts: getData().contacts.map((c) => c.phone),\n  }\n\n  const ok = await deliver(alert, api)\n\n  if (!ok) {\n    patch((d) => ({\n      queue: [...d.queue, alert]\n    }))\n\n    log('Alert Queued For Retry', 'pending')\n  }\n}\n\n// Called when the phone drops off after an SOS (offline event or the demo button).\nexport function queueConnectionLost(api) {\n  const { patch, log, getData } = api\n  const last = getData().lastKnown\n\n  if (!last) return\n\n  log('Connection lost after emergency activation', 'failed')\n\n  const alert = {\n    id: crypto.randomUUID(),\n    createdAt: Date.now(),\n    reason: 'connection-lost',\n    text: buildMessage({\n      position: last.position,\n      battery: last.battery,\n      at: last.lastActive,\n      lost: true,\n      profile: getData().profile\n    }),\n    contacts: getData().contacts.map((c) => c.phone),\n  }\n\n  patch((d) => ({\n    queue: [...d.queue, alert]\n  }))\n}\n\n// Resend everything waiting in the queue.\nexport async function retryQueue(api) {\n  const { patch, log, getData } = api\n  const waiting = getData().queue\n\n  if (!waiting.length || !navigator.onLine) return\n\n  for (const alert of waiting) {\n    if (await sendInternet(alert)) {\n      patch((d) => ({\n        queue: d.queue.filter((a) => a.id !== alert.id)\n      }))\n\n      log('Alert Delivered', 'done')\n    }\n  }\n}\n\n// The \"send it right now\" path for the visible Emergency button.\n// A browser can't text silently, so this opens the phone's SMS app with every trusted contact\n// and the full message already filled in (location comes from the live GPS tracker).\n// It must run synchronously inside the tap, which is why it uses the last tracked position.\n\nexport function openSmsNow(api) {\n  const d = api.getData()\n\n  const text = buildMessage({\n    position: d.lastKnown?.position ?? null,\n    battery: d.lastKnown?.battery ?? null,\n    profile: d.profile,\n  })\n\n  window.location.href =\n    `sms:${d.contacts.map((c) => c.phone).join(',')}?body=${encodeURIComponent(text)}`\n}\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:49:13.63688Z","iopub.execute_input":"2026-10-25T07:49:13.637437Z","iopub.status.idle":"2026-10-25T07:49:13.772108Z","shell.execute_reply.started":"2026-10-25T07:49:13.637405Z","shell.execute_reply":"2026-10-25T07:49:13.77095Z"}},"outputs":[{"traceback":["\u001b[0;36m  File \u001b[0;32m\"/tmp/ipykernel_49/1987867524.py\"\u001b[0;36m, line \u001b[0;32m169\u001b[0m\n\u001b[0;31m    }\u001b[0m\n\u001b[0m    ^\u001b[0m\n\u001b[0;31mSyntaxError\u001b[0m\u001b[0;31m:\u001b[0m unmatched '}'\n"],"ename":"SyntaxError","evalue":"unmatched '}' (1987867524.py, line 169)","output_type":"error"}],"execution_count":2}]}